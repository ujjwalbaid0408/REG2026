# Data (distributed by organizers; huge)
Data/
Documents/

# Environments / build
venv/
.env_tools/
.conda_pkgs/
*.egg-info/
__pycache__/
*.pyc

# Third-party encoder clone (install separately per README)
repo_conch/

# Large artifacts (regenerate via scripts)
artifacts/embeddings/
artifacts/*/conch_weights/
*.npy
*.tiff
*.tif

# Trained MIL-head weights are small (3-17 MB) -> kept in-tree under artifacts/mil/<run>/mil_head.pt.
# The large third-party FOUNDATION encoders (CONCH ~800 MB, UNI2-h ~2.6 GB) are NOT redistributed:
artifacts/*/conch_weights/
artifacts/*/uni2h_weights/

# Logs / scratch
logs/
results/
*.log
slurm-*.out

# LaTeX build intermediates (keep main.pdf)
report/*.aux
report/*.log
report/*.out
report/*.bbl
report/*.blg
report/*.toc
report/b*.log

# Nested challenge repo internals + provided test data (large; not ours to redistribute)
repo_template/.git/
repo_template/submission_evaluation_code/data/
repo_template/**/test/input/
repo_template/**/test/output/
repo_template/media/
*.mha
*.tif

# Submission model artifacts (assembled by prepare_model.sh; large)
repo_template/**/model/
repo_template/**/*.tar.gz

# Editor/template backups
*.bak
*.pre_emptyfix.bak
